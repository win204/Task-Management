# ══════════════════════════════════════════════════════════════════════════════
# Task Management System — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in EVERY value marked with CHANGE_ME
#   3. NEVER commit the resulting .env file to Git
#   4. The .env file is already listed in .gitignore
#
# ══════════════════════════════════════════════════════════════════════════════

# ─── SQL Server ──────────────────────────────────────────────────────────────
# SA password for the SQL Server container (must meet SQL Server complexity rules:
#   min 8 chars, upper + lower + digit + special)
SA_PASSWORD=CHANGE_ME_DB_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Long random string used to sign JWT tokens.
# Generate a strong one: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# ─── SMTP / Email (Gmail) ────────────────────────────────────────────────────
# Your Gmail address (used as the "From" sender and test recipient)
SPRING_MAIL_USERNAME=CHANGE_ME_YOUR_EMAIL@gmail.com

# Google App Password (16 characters, NO spaces)
# This is NOT your Gmail login password.
# Generate one at: https://myaccount.google.com/apppasswords
#   Steps: Google Account → Security → 2-Step Verification → App passwords
SPRING_MAIL_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD

# SMTP server settings (defaults are correct for Gmail — change only if needed)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL used in password-reset emails (must be reachable by the end user)
APP_RESET_URL=http://localhost:5173
