<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="phong">
        <createTable tableName="positions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="name" type="NVARCHAR(100)"/>
        </createTable>

        <insert tableName="positions">
            <column name="description" value="Java Spring Boot Developer"/>
            <column name="name" value="Backend Developer"/>
        </insert>
        <insert tableName="positions">
            <column name="description" value="ReactJS Developer"/>
            <column name="name" value="Frontend Developer"/>
        </insert>
        <insert tableName="positions">
            <column name="description" value="Software Tester"/>
            <column name="name" value="QA Tester"/>
        </insert>
    </changeSet>

</databaseChangeLog>
