<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="5" author="phong">
        <createTable tableName="tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="NVARCHAR(MAX)"/>
            <column name="due_date" type="DATE"/>
            <column name="priority" type="VARCHAR(255)"/>
            <column name="start_date" type="DATE"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="title" type="NVARCHAR(255)"/>
            <column name="assignee_id" type="BIGINT"/>
            <column name="project_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="assignee_id"
                                 baseTableName="tasks"
                                 constraintName="FKekr1dgiqktpyoip3qmp6lxsit"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addForeignKeyConstraint baseColumnNames="project_id"
                                 baseTableName="tasks"
                                 constraintName="FKsfhn82y57i3k9uxww1s007acc"
                                 referencedColumnNames="id"
                                 referencedTableName="projects"/>

