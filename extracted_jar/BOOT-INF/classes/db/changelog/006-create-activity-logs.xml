<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6" author="phong">
        <createTable tableName="activity_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="action" type="NVARCHAR(100)"/>
            <column name="created_at" type="DATETIME2(6)"/>
            <column name="description" type="NVARCHAR(MAX)"/>
            <column name="task_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="activity_logs"
                                 constraintName="FK5bm1lt4f4eevt8lv2517soakd"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addForeignKeyConstraint baseColumnNames="task_id"
                                 baseTableName="activity_logs"
                                 constraintName="FKtoru9k6tjr6ifdjhood8onue8"
                                 referencedColumnNames="id"
                                 referencedTableName="tasks"/>

        <!-- <insert tableName="activity_logs">
            <column name="action" value="CREATE_TASK"/>
