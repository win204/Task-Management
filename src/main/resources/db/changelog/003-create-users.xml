<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="3" author="phong">
        <!-- Create users table -->
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="full_name" type="NVARCHAR(100)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="status" type="BIT"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="active" type="BIT"/>
            <column name="created_at" type="DATETIME2(6)"/>
            <column name="updated_at" type="DATETIME2(6)"/>
        </createTable>


        <!-- Create user_roles table -->
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>


        <!-- Create user_positions table -->
        <createTable tableName="user_positions">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="position_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="user_positions"
                                 constraintName="FK49ffcx0xclhe2oof19cty66v0"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>

        <addForeignKeyConstraint baseColumnNames="position_id"
                                 baseTableName="user_positions"
                                 constraintName="FKqieyn6an8qsrf02uvgsieege6"
                                 referencedColumnNames="id"
                                 referencedTableName="positions"/>
    </changeSet>

</databaseChangeLog>
