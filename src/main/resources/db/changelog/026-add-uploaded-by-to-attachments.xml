<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="26" author="phong">
        <addColumn tableName="attachments">
            <column name="uploaded_by_id" type="BIGINT"/>
        </addColumn>
        
        <addForeignKeyConstraint baseColumnNames="uploaded_by_id"
                                 baseTableName="attachments"
                                 constraintName="fk_attachments_uploaded_by"
                                 referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>

</databaseChangeLog>
